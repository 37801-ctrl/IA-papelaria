import model.ItemPedido;

/*
RESPOSTAS:
 * 
 * a) Qual bloco está repetido?
 *    O cálculo do valor bruto, do desconto e do valor líquido 
 * 
 * 
 * b) Quais variáveis estão numeradas?
 *    descricao1..4, valor1..4, qtd1..4, kit1..4,
 *  bruto1..4, abatimento1..4, liquido1..4.
 * 
 * c) Quais números mágicos existem e o que significam?
 *    - 0.15: Desconto de 15% para kits
 *    - 10: Quantidade mínima para atacado
 *    - 0.08: Desconto de 8% para atacado
 *    - 150.0: Valor mínimo para frete grátis
 *    - 12.90: Valor do frete fixo
 */
public class Papelaria {

    
    public static final double FRETE_GRATIS_MINIMO = 150.0;
    public static final double VALOR_FRETE = 12.90;

    public static void main(String[] args) {
        System.out.println("=== PAPELARIA PONTO FINAL ===\n");

        
        ItemPedido item1 = new ItemPedido("Caderno 10 materias", 24.90, 1, false);
        ItemPedido item2 = new ItemPedido("Lapis grafite", 1.50, 12, false);
        ItemPedido item3 = new ItemPedido("Kit escolar basico", 84.00, 1, true);
        ItemPedido item4 = new ItemPedido("Caneta azul", 2.80, 10, false);

        
        item1.exibirLinha();
        item2.exibirLinha();
        item3.exibirLinha();
        item4.exibirLinha();

        
        double soma = item1.calcularValorLiquido() 
                    + item2.calcularValorLiquido() 
                    + item3.calcularValorLiquido() 
                    + item4.calcularValorLiquido();

        
        double frete = calcularFrete(soma);

        
        System.out.printf("%nItens:  R$ %.2f%n", soma);
        System.out.printf("Frete:  R$ %.2f%n", frete);
        System.out.printf("Total do pedido: R$ %.2f%n", soma + frete);
    }

    
    public static double calcularFrete(double valorItens) {
        if (valorItens >= FRETE_GRATIS_MINIMO) {
            return 0.0;
        }
        return VALOR_FRETE;
    }
}